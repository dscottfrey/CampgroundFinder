# Copy to .env (gitignored — NEVER commit the real file, §13).

# Match your local days so weekends-only and "tonight" mean what you expect.
TZ=America/Los_Angeles

# Where the SQLite database lives.
CAMPGROUNDFINDER_DB=data/campgroundfinder.db

# Apprise notification URLs (§11). Keep any ntfy topic secret — it's the auth.
# NTFY_TOPIC=change-me-campgroundfinder
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: a free RIDB key buys richer facility metadata (§13). Not required.
# RIDB_API_KEY=

# Optional, step 6: Tailscale sidecar auth key.
# TS_AUTHKEY=
